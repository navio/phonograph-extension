{
  "name": "Phonograph",
  "version": "1.0.3",
  "description": "Phonograph is Podcast Player Extension",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Phonograph"
  },
  "permissions": [
    "storage",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "icons": { 
   "128": "icon128.png" },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "manifest_version": 3
}